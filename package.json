{
    "name": "enliwfen",
    "version": "0.1.0",
    "description": "A script to enliven web sites served by web frameworks like Django.",
    "homepage": "https://github.com/hwirths/enliwfen",
    "bugs": {
        "url": "https://github.com/hwirths/enliwfen/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hwirths/enliwfen.git"
    },
    "dependencies": {
        "esm": "^3.2.25"
    },
    "private": true,
    "type": "module",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "dev": "./node_modules/.bin/vite",
        "test": "./node_modules/.bin/vitest",
        "compile": "tsc",
        "build": "tsc && ./node_modules/.bin/vite build",
        "preview": "./node_modules/.bin/vite preview"
    },
    "devDependencies": {
        "jsdom": "^29.1.1",
        "typescript": "~6.0.2",
        "vite": "^8.1.1",
        "vitest": "^5.0.1"
    }
}
